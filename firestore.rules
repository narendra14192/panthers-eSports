rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Meta (seeding sentinel) ─────────────────────────────────────────────
    match /_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Tournaments — public read, auth write ───────────────────────────────
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Slots — public read, open booking ──────────────────────────────────
    match /slots/{slotId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // ── Teams — public read, squad creation ─────────────────────────────────
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // ── Leaderboard — public read, auth write ──────────────────────────────
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Matches — public read, auth write ──────────────────────────────────
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Admin Logs — public readable/writable for audit logging ────────────
    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    // ── Tournament Registrations (UTR/payments) — public submit & read ─────
    match /tournament_registrations/{regId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
